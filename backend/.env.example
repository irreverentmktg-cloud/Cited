# ── AI Model API Keys ────────────────────────────────────────
# MINIMUM TO TEST: just add ANTHROPIC_API_KEY
# That gives you: scraping, prompt generation, AND Claude citation checks.
#
# Add the others as you get them to unlock each model's citation tracking.

ANTHROPIC_API_KEY=sk-ant-...   # ← start here (used for scraping + Claude checks)
OPENAI_API_KEY=sk-...          # ← add for ChatGPT checks
PERPLEXITY_API_KEY=pplx-...    # ← add for Perplexity checks
GOOGLE_GEMINI_API_KEY=AIza...  # ← add for Gemini checks

# ── Supabase ─────────────────────────────────────────────────
# Use the SERVICE ROLE key (bypasses RLS) — never expose to frontend
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Server ───────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Rate Limiting ────────────────────────────────────────────
# Max concurrent LLM calls at once (avoid API rate limits)
LLM_CONCURRENCY=5
# Delay between calls to same model in ms
LLM_DELAY_MS=500

# ── Job Config ───────────────────────────────────────────────
# Cron schedule for nightly run (default: 2am UTC)
NIGHTLY_CRON=0 2 * * *
# How many brands to process in parallel
JOB_BRAND_CONCURRENCY=3
